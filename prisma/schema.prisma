generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================
// Utilizadores e organizações
// =========================

enum OrganizationRole {
  OWNER
  ADMIN
  STAFF
  READER
}

enum AgentKind {
  PERSON
  CORPORATE_BODY
  UNKNOWN
}

enum ContributionSource {
  PORBASE
  MANUAL
}

model Organization {
  id                      String   @id @default(cuid())
  name                    String
  defaultCatalogueSource  String?  @default("porbase")
  enabledCatalogueSources String[] @default(["porbase"])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  memberships OrganizationMembership[]
  libraries   Library[]
  works       Work[]
  agents      Agent[]
  coverAssets CoverAsset[]
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  passwordHash        String
  refreshToken        String?
  refreshTokenExpires DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships OrganizationMembership[]

  @@index([createdAt, id])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, userId])
}

model Library {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations    Location[]

  @@unique([organizationId, name])
  @@index([organizationId, createdAt, id])
}

model Location {
  id        String   @id @default(cuid())
  libraryId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  library  Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  holdings Holding[]

  @@unique([libraryId, name])
  @@index([libraryId, createdAt, id])
}

// =========================
// Núcleo bibliográfico
// =========================

model Work {
  // title/subtitle are a transitional projection of the MAIN WorkTitle row;
  // WorkTitle is the canonical source of truth (Phase 1 foundation).
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  editions      Edition[]
  contributions Contribution[]
  titles        WorkTitle[]
  notes         BibliographicNote[]

  @@index([organizationId, createdAt, id])
}

model Edition {
  // title/subtitle/language are a transitional projection of the MAIN
  // EditionTitle row and the TEXT EditionLanguage row; the structured
  // relations below are the canonical source of truth (Phase 1 foundation).
  // publisher/publicationDate/publicationPlace are likewise a projection of
  // PublicationStatement when statements exist (pre-existing behaviour).
  id               String   @id @default(cuid())
  title            String // título da edição (pode ser igual ao da obra)
  subtitle         String?
  isbn10           String?  @db.Char(10)
  isbn13           String?  @db.Char(13)
  publisher        String?
  publicationDate  String?  @db.VarChar(10)
  publicationPlace String?
  language         String?
  country          String?
  format           String? // ex: "Hardcover", "Paperback", "eBook"
  pageCount        Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  holdings                 Holding[]
  physicalDescriptions     PhysicalDescription[]
  publicationStatements    PublicationStatement[]
  contributions            Contribution[]
  externalIdentifiers      ExternalIdentifier[]
  bibliographicRecords     BibliographicRecord[]
  titles                   EditionTitle[]
  responsibilityStatements ResponsibilityStatement[]
  languages                EditionLanguage[]
  series                   Series[]
  editionStatements        EditionStatement[]
  classifications          Classification[]
  notes                    BibliographicNote[]
  editionCovers            EditionCover[]

  @@index([workId, createdAt, id])
}

// =========================
// Phase 1 canonical model foundation
// =========================
//
// These models are the canonical source of truth for the concepts they
// represent. The scalar fields retained on Work/Edition (title, subtitle,
// language, publisher, publicationDate, publicationPlace) are transitional
// projections kept for read/query convenience and backward compatibility;
// they are not authoritative once a structured row exists for that concept.
// The PORBASE parser, preview mapper and import persistence write these
// relations during the explicit import confirmation flow.

enum TitleType {
  MAIN
  PARALLEL
  VARIANT
  OTHER
}

model WorkTitle {
  id        String    @id @default(cuid())
  workId    String
  type      TitleType @default(MAIN)
  value     String
  subtitle  String?
  language  String?
  sortOrder Int       @default(0)
  source    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId, sortOrder, id])
}

model EditionTitle {
  id        String    @id @default(cuid())
  editionId String
  type      TitleType @default(MAIN)
  value     String
  subtitle  String?
  language  String?
  sortOrder Int       @default(0)
  source    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, sortOrder, id])
}

enum ResponsibilityStatementLabel {
  STATEMENT
  SUBSEQUENT_STATEMENT
}

// Verbatim transcription of 200$f/$g, deliberately distinct from the
// structured Agent/Contribution graph derived from 700-723.
model ResponsibilityStatement {
  id        String                       @id @default(cuid())
  editionId String
  label     ResponsibilityStatementLabel @default(STATEMENT)
  value     String                       @db.Text
  sortOrder Int                          @default(0)
  source    String?
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, sortOrder, id])
}

enum EditionLanguageRole {
  TEXT
  ORIGINAL_LANGUAGE
  PARALLEL_TEXT
  SUBTITLES
}

model EditionLanguage {
  id        String              @id @default(cuid())
  editionId String
  code      String              @db.VarChar(10)
  role      EditionLanguageRole @default(TEXT)
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, sortOrder, id])
}

model Series {
  id            String   @id @default(cuid())
  editionId     String
  title         String
  parallelTitle String?
  volumeNumber  String?
  issn          String?
  sortOrder     Int      @default(0)
  source        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, sortOrder, id])
}

model EditionStatement {
  id        String   @id @default(cuid())
  editionId String
  value     String   @db.Text
  kind      String
  label     String?
  sortOrder Int      @default(0)
  sourceTag String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, sortOrder, id])
}

enum BibliographicNoteType {
  GENERAL
  BIBLIOGRAPHY
  CONTENTS
  SUMMARY
  PROVENANCE
  DISSERTATION
  OTHER
}

// Targets exactly one of Work or Edition (enforced by a DB check
// constraint), mirroring the existing Contribution XOR pattern.
model BibliographicNote {
  id        String                @id @default(cuid())
  workId    String?
  editionId String?
  type      BibliographicNoteType @default(GENERAL)
  value     String                @db.Text
  sortOrder Int                   @default(0)
  source    String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  work    Work?    @relation(fields: [workId], references: [id], onDelete: Cascade)
  edition Edition? @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([workId, sortOrder, id])
  @@index([editionId, sortOrder, id])
}

// Minimal classification support (e.g. UNIMARC 675 UDC notations).
model Classification {
  id            String   @id @default(cuid())
  editionId     String
  notation      String
  system        String
  systemEdition String?
  authorityId   String?
  sortOrder     Int      @default(0)
  source        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, sortOrder, id])
}

// Preserves source datafields that a mapper could not map to a Phase 1
// concept, so nothing is silently dropped beyond BibliographicRecord.rawContent.
model UnmappedSourceField {
  id                    String   @id @default(cuid())
  bibliographicRecordId String
  tag                   String   @db.Char(3)
  indicator1            String?  @db.Char(1)
  indicator2            String?  @db.Char(1)
  occurrence            Int      @default(0)
  reason                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  bibliographicRecord BibliographicRecord      @relation(fields: [bibliographicRecordId], references: [id], onDelete: Cascade)
  subfields           UnmappedSourceSubfield[]

  @@index([bibliographicRecordId, tag, occurrence])
}

model UnmappedSourceSubfield {
  id                    String   @id @default(cuid())
  unmappedSourceFieldId String
  code                  String   @db.Char(1)
  value                 String   @db.Text
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  unmappedSourceField UnmappedSourceField @relation(fields: [unmappedSourceFieldId], references: [id], onDelete: Cascade)

  @@index([unmappedSourceFieldId, sortOrder])
}

model PublicationStatement {
  id         String   @id @default(cuid())
  editionId  String
  sortOrder  Int      @default(0)
  indicator1 String   @default(" ") @db.Char(1)
  indicator2 String   @default("9") @db.Char(1)
  source     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  edition Edition                    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  parts   PublicationStatementPart[]

  @@index([editionId, sortOrder, id])
}

model PublicationStatementPart {
  id                     String   @id @default(cuid())
  publicationStatementId String
  subfield               String   @db.Char(1)
  value                  String   @db.Text
  sortOrder              Int      @default(0)
  groupIndex             Int      @default(0)
  normalizedValue        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  publicationStatement PublicationStatement @relation(fields: [publicationStatementId], references: [id], onDelete: Cascade)

  @@index([publicationStatementId, sortOrder, id])
}

model PhysicalDescription {
  id        String   @id @default(cuid())
  editionId String
  sortOrder Int      @default(0)
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition Edition                   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  parts   PhysicalDescriptionPart[]

  @@index([editionId, sortOrder, id])
}

model PhysicalDescriptionPart {
  id                    String   @id @default(cuid())
  physicalDescriptionId String
  subfield              String   @db.Char(1)
  value                 String   @db.Text
  sortOrder             Int      @default(0)
  normalizedValue       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  physicalDescription PhysicalDescription @relation(fields: [physicalDescriptionId], references: [id], onDelete: Cascade)

  @@index([physicalDescriptionId, sortOrder, id])
}

model Agent {
  id                    String    @id @default(cuid())
  organizationId        String
  kind                  AgentKind @default(UNKNOWN)
  displayName           String
  normalizedDisplayName String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contributions Contribution[]

  @@index([organizationId, kind, normalizedDisplayName])
  @@index([organizationId, displayName])
}

model Contribution {
  id                     String             @id @default(cuid())
  agentId                String
  workId                 String?
  editionId              String?
  sortOrder              Int                @default(0)
  roleLabel              String?
  relationshipCodeScheme String?
  authorityId            String?
  source                 ContributionSource
  sourceTag              String?            @db.Char(3)
  indicator1             String?            @db.Char(1)
  indicator2             String?            @db.Char(1)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  agent       Agent                    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  work        Work?                    @relation(fields: [workId], references: [id], onDelete: Cascade)
  edition     Edition?                 @relation(fields: [editionId], references: [id], onDelete: Cascade)
  sourceParts ContributionSourcePart[]

  @@index([workId, sortOrder, id])
  @@index([editionId, sortOrder, id])
  @@index([agentId])
}

model ContributionSourcePart {
  id             String   @id @default(cuid())
  contributionId String
  code           String   @db.Char(1)
  value          String   @db.Text
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@index([contributionId, sortOrder, id])
}

model ExternalIdentifier {
  id        String   @id @default(cuid())
  type      String // ex: "ISBN-10", "ISBN-13", "BNP", "OPENLIBRARY", "OCLC", "LCCN"
  value     String
  source    String? // ex: "BNP", "Open Library"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editionId String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, type, value])
  @@index([editionId, createdAt, id])
}

model BibliographicRecord {
  // Each persisted source record has one canonical Edition target. Work is
  // derived through Edition -> Work rather than stored as a second owner.
  id         String   @id @default(cuid())
  format     String // ex: "MARCXML", "ISO2709", "MARCJSON"
  rawContent String   @db.Text // registo bruto (pode ser grande)
  source     String? // ex: "BNP", "Open Library"
  remoteId   String? // identificador na fonte
  sourceId   String? // id do CatalogueProvider que produziu o registo (ex: "porbase")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  editionId String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  unmappedSourceFields UnmappedSourceField[]
  coverCandidates      CoverCandidate[]

  @@index([editionId, createdAt, id])
}

model CoverCandidate {
  id                    String    @id @default(cuid())
  bibliographicRecordId String
  url                   String
  urlHash               String
  sourceType            String    @default("PORBASE")
  mimeType              String?
  status                String    @default("PENDING")
  rejectReason          String?
  coverAssetId          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  nextAttemptAt         DateTime?
  retryCount            Int       @default(0)

  bibliographicRecord BibliographicRecord @relation(fields: [bibliographicRecordId], references: [id], onDelete: Cascade)
  coverAsset          CoverAsset?         @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)

  @@unique([bibliographicRecordId, urlHash])
  @@index([status])
  @@index([nextAttemptAt])
  @@index([sourceType])
}

model CoverAsset {
  id             String   @id @default(cuid())
  // Deliberately organization-scoped for storage-key isolation and deduplication.
  // Cross-model organization equality is enforced by baseline constraint triggers.
  organizationId String
  storageBackend String
  storageKey     String
  contentHash    String
  mimeType       String
  sizeBytes      Int
  width          Int?
  height         Int?
  createdAt      DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  coverCandidates CoverCandidate[]
  editionCovers   EditionCover[]

  @@unique([organizationId, contentHash])
  @@index([storageBackend])
}

model EditionCover {
  id           String   @id @default(cuid())
  editionId    String
  coverAssetId String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  edition    Edition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  coverAsset CoverAsset @relation(fields: [coverAssetId], references: [id], onDelete: Cascade)

  @@unique([editionId, coverAssetId])
  @@index([isActive])
}

model Item {
  id        String   @id @default(cuid())
  label     String?
  status    String   @default("OWNED")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holdingId String
  holding   Holding @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@index([holdingId, createdAt, id])
}

model Holding {
  id         String   @id @default(cuid())
  editionId  String
  locationId String
  // Call number and notes describe the shared possession, not an individual copy.
  callNumber String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  edition  Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items    Item[]

  @@index([editionId, createdAt, id])
  @@index([locationId, createdAt, id])
}
