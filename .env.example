DATABASE_URL="postgresql://folio_owner:CHANGE_ME@192.168.1.177:5432/folio?schema=public"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:4200,https://folio.test"
# Pool and timeout values are applied by pg.Pool/Node HTTP server.
DATABASE_POOL_MAX="10"
DATABASE_CONNECTION_TIMEOUT_MS="5000"
DATABASE_IDLE_TIMEOUT_MS="10000"
DATABASE_QUERY_TIMEOUT_MS="10000"
APP_REQUEST_TIMEOUT_MS="15000"
APP_HEADERS_TIMEOUT_MS="20000"
APP_KEEP_ALIVE_TIMEOUT_MS="5000"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
PORBASE_URN_BASE_URL="https://urn.porbase.org/isbn/unimarc/marcxchange"
PORBASE_URN_TIMEOUT_MS="5000"
# Only takes effect when NODE_ENV=development; ignored otherwise.
ERROR_DETAILS_IN_RESPONSE="false"
COVER_STORAGE_BACKEND="local_fs"
COVER_STORAGE_ROOT="./storage/covers"
COVER_ALLOWED_HOSTS="images.porbase.pt,purl.pt"
COVER_HTTP_TIMEOUT="10000"
COVER_CONNECT_TIMEOUT="5000"
COVER_MAX_SIZE_BYTES="5242880"
COVER_MAX_WIDTH="5000"
COVER_MAX_HEIGHT="5000"
THROTTLE_TTL="60000"
THROTTLE_LIMIT="10"
